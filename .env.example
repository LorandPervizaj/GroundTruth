# Copy to .env and adjust. Placeholder values only — never commit .env or .env.local.
# Production: set strong POSTGRES_PASSWORD, PGADMIN_PASSWORD, and DATABASE_URL via env;
# do not use the dev defaults below.

# Application
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console
PUBLIC_BASE_URL=http://127.0.0.1:8000
API_DOCS_ENABLED=false

# Database
# If Windows Hyper-V excludes host port 5432, use another port (e.g. 15432) in BOTH
# DATABASE_URL and POSTGRES_PORT so Docker can publish and the app can connect.
DATABASE_URL=postgresql+psycopg://groundtruth:groundtruth_dev_password@localhost:5432/groundtruth
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Docker Compose (used by docker-compose.yml)
POSTGRES_USER=groundtruth
POSTGRES_PASSWORD=groundtruth_dev_password
POSTGRES_DB=groundtruth
POSTGRES_PORT=5432

PGADMIN_EMAIL=admin@groundtruth.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Reports (generated output — never commit)
REPORTS_GENERATED_DIR=reports/generated
REPORTS_TEMPLATES_DIR=reports/templates
PRODUCT_LOG_DIR=data/product
PRODUCT_WRITE_BACKEND=jsonl

# Scraping
SCRAPY_DOWNLOAD_DELAY=2.0
SCRAPY_CONCURRENT_REQUESTS=4
SCRAPY_USER_AGENT_ROTATION=true
# Fast mode: higher concurrency (opt-in only — default is conservative crawl speed)
SCRAPY_FAST_MODE=false
SCRAPY_HTML_CONCURRENT_REQUESTS=16
SCRAPY_HTML_DOWNLOAD_DELAY=0.25
SCRAPY_API_CONCURRENT_REQUESTS=32

# Weekly crawl (scripts\run_weekly.cmd updates these interactively)
WEEKLY_CRAWL_PARALLEL_WORKERS=8
WEEKLY_CRAWL_TRAILING_ETL=true

# Geocoding
GEOCODING_ENABLED=false
NOMINATIM_USER_AGENT=groundtruth-kosovo-market-analysis/0.1.0

# Optional operational notifications. Store real values in local/cloud secrets only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional detailed email report (Gmail: use an app password, never the account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PIPELINE_EMAIL_TO=

# Gazetteers
GAZETTEER_DIR=data/gazetteers

# Deduplication
DEDUP_FUZZY_THRESHOLD=85.0
DEDUP_AUTO_MERGE=false

# API security (internet-facing deploy — tune per environment)
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_FEEDBACK=5/hour
API_RATE_LIMIT_ALERTS=3/hour
API_RATE_LIMIT_EVENTS=60/hour
API_RATE_LIMIT_VALUATE=30/hour
API_RATE_LIMIT_LANG=30/hour
API_RATE_LIMIT_CONTACT=5/hour
API_MAX_BODY_BYTES=32768
API_SEARCH_MAX_LENGTH=80
API_SEARCH_TIMEOUT_SEC=5.0
API_VALUATE_TIMEOUT_SEC=15.0
API_REQUIRE_LOOKUP_CACHE=true

# Data retention (research DB — days before raw content purge)
RAW_HTML_RETENTION_DAYS=730
RAW_PAYLOAD_RETENTION_DAYS=730
PARSED_DESCRIPTION_RETENTION_DAYS=730

# Product / feature flags
VALUATION_PUBLIC_ENABLED=false
ALERTS_SIGNUP_ENABLED=false
API_COMPARE_MAX_NEIGHBORHOODS=3
PRODUCT_SUBMISSION_DEDUPE_SECONDS=300
RUN_MIGRATIONS_ON_START=true
PARSE_FAILURE_ALERT_THRESHOLD=0.10
API_RATE_LIMIT_REPORT_REFRESH=2/hour
API_RATE_LIMIT_CONTACT=5/hour

# Observability (optional in development)
# SENTRY_DSN=
REQUIRE_SENTRY_DSN=false
SENTRY_TRACES_SAMPLE_RATE=0.0
# HEALTH_CHECK_TOKEN is optional in development; required-ish for gated /api/metrics in non-dev.
HEALTH_CHECK_TOKEN=
FORWARDED_ALLOW_IPS=127.0.0.1
# Extra Host values for TrustedHostMiddleware (comma-separated). Empty is fine locally.
TRUSTED_HOSTS=

