# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# Environment
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing / linters
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Training data collected at runtime (keep structure)
data/training/*
!data/training/.gitkeep

# Data (keep structure, ignore scraped content)
data/raw/**
data/parsed/**
data/normalized/**
!data/raw/.gitkeep
!data/parsed/.gitkeep
!data/normalized/.gitkeep

# Scrapy
.scrapy/

# Playwright
playwright-report/
test-results/

# OS
.DS_Store
Thumbs.db

# Generated reports (never beside source code)
reports/generated/**
!reports/generated/.gitkeep
!reports/generated/lookup_cache/
!reports/generated/lookup_cache/**
reports/lighthouse-*.json
backups/

# Local research probes and temporary investigation notes
scratch/
scripts/_*.py
_*.txt
/test.py

# Jupyter
.ipynb_checkpoints/

# Informal / quarantined sources (may contain contact data in captures)
data/sources/facebook/**
data/sources/facebook-groups/**
!data/sources/facebook/README.md
!data/sources/facebook-groups/README.md

# Runtime product logs (user emails, feedback text)
data/product/*.jsonl

# Dedup review registers (regenerate locally; see data/deduplication/README.md)
data/deduplication/*.csv
!data/deduplication/README.md
!data/deduplication/benchmark.csv

# QA temporary artifacts
.tmp/
deploy/nginx/certs/*.pem
