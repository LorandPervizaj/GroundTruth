# Copy to .env.production on the deployment host. Do not commit real secrets.

APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json
PUBLIC_BASE_URL=https://metrik.example.com
API_DOCS_ENABLED=false
API_REQUIRE_LOOKUP_CACHE=true

DATABASE_URL=postgresql+psycopg://groundtruth_app:replace-me@postgres:5432/groundtruth
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

POSTGRES_USER=groundtruth_app
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=groundtruth

REPORTS_GENERATED_DIR=/app/reports/generated
REPORTS_TEMPLATES_DIR=/app/reports/templates
PRODUCT_WRITE_BACKEND=database
PRODUCT_LOG_DIR=/app/data/product

API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_FEEDBACK=5/hour
API_RATE_LIMIT_ALERTS=3/hour
API_RATE_LIMIT_EVENTS=60/hour
API_RATE_LIMIT_VALUATE=30/hour
API_RATE_LIMIT_LANG=30/hour
API_RATE_LIMIT_CONTACT=10/hour
API_RATE_LIMIT_REPORT_REFRESH=2/hour
API_MAX_BODY_BYTES=32768
API_SEARCH_MAX_LENGTH=80
API_SEARCH_TIMEOUT_SEC=5.0
API_VALUATE_TIMEOUT_SEC=15.0
# Keep disabled until `groundtruth evaluation gate` passes the frozen holdout.
VALUATION_PUBLIC_ENABLED=false

# Observability (optional)
# SENTRY_DSN=https://example@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1
HEALTH_CHECK_TOKEN=replace-me-with-random-token
# Trust forwarded headers only from the private Docker network used by nginx.
FORWARDED_ALLOW_IPS=172.16.0.0/12

GAZETTEER_DIR=/app/data/gazetteers
GEOCODING_ENABLED=false
